rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default-deny all unmatched paths)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Global Authentication & Role Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        // Priority 1: Firebase Auth Custom Claims
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'Admin' ||
        // Priority 2: Verified entry in secure admins collection
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        // Priority 3: Verified bootstrap administrator account
        request.auth.token.email == 'its.me.jckirthi@gmail.com'
      );
    }

    function isOfficial() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Citizen') in ['Official', 'Admin'])
      );
    }

    // -------------------------------------------------------------
    // User Profile Validation Blueprints
    // -------------------------------------------------------------
    function isValidUserProfileCreate(data, userId) {
      return data.uid == userId &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
             (!('points' in data) || (data.points is number && data.points >= 0)) &&
             (!('badges' in data) || (data.badges is list && data.badges.size() <= 50)) &&
             (!('reportedCount' in data) || (data.reportedCount is number && data.reportedCount >= 0)) &&
             (!('verifiedCount' in data) || (data.verifiedCount is number && data.verifiedCount >= 0)) &&
             (!('resolvedCount' in data) || (data.resolvedCount is number && data.resolvedCount >= 0)) &&
             (!('role' in data) || data.role in ['Citizen', 'Official', 'Admin']);
    }

    function isValidUserProfileUpdate(existingData, incomingData) {
      return incomingData.uid == existingData.uid &&
             (!('displayName' in incomingData) || (incomingData.displayName is string && incomingData.displayName.size() <= 150)) &&
             (!('email' in incomingData) || (incomingData.email is string && incomingData.email.size() <= 200)) &&
             (!('photoURL' in incomingData) || (incomingData.photoURL is string && incomingData.photoURL.size() <= 2000)) &&
             (!('points' in incomingData) || (incomingData.points is number && incomingData.points >= 0)) &&
             (!('badges' in incomingData) || (incomingData.badges is list && incomingData.badges.size() <= 50)) &&
             (!('reportedCount' in incomingData) || (incomingData.reportedCount is number && incomingData.reportedCount >= 0)) &&
             (!('verifiedCount' in incomingData) || (incomingData.verifiedCount is number && incomingData.verifiedCount >= 0)) &&
             (!('resolvedCount' in incomingData) || (incomingData.resolvedCount is number && incomingData.resolvedCount >= 0)) &&
             (!('role' in incomingData) || incomingData.role in ['Citizen', 'Official', 'Admin']);
    }

    // -------------------------------------------------------------
    // Civic Issue Validation Blueprints
    // -------------------------------------------------------------
    function isValidCivicIssueCreate(data, issueId) {
      return data.id == issueId &&
             data.title is string && data.title.size() <= 300 &&
             data.description is string && data.description.size() <= 10000 &&
             data.category in ['Pothole', 'Water Leak', 'Broken Streetlight', 'Trash & Dumping', 'Graffiti', 'Other'] &&
             data.urgency in ['Low', 'Medium', 'High', 'Critical'] &&
             data.locationName is string && data.locationName.size() <= 1000 &&
             data.latitude is number &&
             data.longitude is number &&
             data.status in ['Reported', 'Verified', 'Assigned', 'In Progress', 'Repair Scheduled', 'Fix Completed', 'Resolved'] &&
             data.reportedBy is string &&
             data.reportedByName is string && data.reportedByName.size() <= 150 &&
             data.reportedAt is number &&
             (!('verificationsCount' in data) || data.verificationsCount is number) &&
             (!('verifiedBy' in data) || (data.verifiedBy is list && data.verifiedBy.size() <= 5000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
             (!('voiceUrl' in data) || (data.voiceUrl is string && data.voiceUrl.size() <= 2000000)) &&
             (!('severity' in data) || data.severity is number) &&
             (!('severityRationale' in data) || (data.severityRationale is string && data.severityRationale.size() <= 3000)) &&
             (!('department' in data) || (data.department in ['BBMP', 'BWSSB', 'BESCOM', 'Other'])) &&
             (!('assignedDepartment' in data) || (data.assignedDepartment in ['BBMP', 'BWSSB', 'BESCOM', 'Other'])) &&
             (!('hazards' in data) || (data.hazards is list && data.hazards.size() <= 30)) &&
             (!('aiConfidence' in data) || data.aiConfidence is number) &&
             (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 3000)) &&
             (!('timestamps' in data) || data.timestamps is map) &&
             (!('relatedIssues' in data) || data.relatedIssues is list) &&
             (!('voiceTranscript' in data) || (data.voiceTranscript is string && data.voiceTranscript.size() <= 5000)) &&
             (!('locationHints' in data) || data.locationHints is list) &&
             (!('landmarks' in data) || data.landmarks is list) &&
             (!('slaExpectedHours' in data) || data.slaExpectedHours is number) &&
             (!('upvotesCount' in data) || data.upvotesCount is number) &&
             (!('upvotedBy' in data) || data.upvotedBy is list) &&
             (!('originalLanguage' in data) || data.originalLanguage is string) &&
             (!('originalTitle' in data) || data.originalTitle is string) &&
             (!('originalDescription' in data) || data.originalDescription is string) &&
             (!('officialResponse' in data) || (data.officialResponse is string && data.officialResponse.size() <= 5000)) &&
             (!('officialResponseAt' in data) || data.officialResponseAt is number);
    }

    function isValidVerificationAction(existingData, incomingData) {
      return incomingData.id == existingData.id &&
             incomingData.reportedBy == existingData.reportedBy &&
             incomingData.verifiedBy is list &&
             incomingData.verificationsCount is number;
    }

    function isValidOfficialStatusUpdate(existingData, incomingData) {
      return incomingData.id == existingData.id &&
             incomingData.reportedBy == existingData.reportedBy &&
             incomingData.status in ['Reported', 'Verified', 'Assigned', 'In Progress', 'Repair Scheduled', 'Fix Completed', 'Resolved'] &&
             (!('officialResponse' in incomingData) || (incomingData.officialResponse is string && incomingData.officialResponse.size() <= 5000)) &&
             (!('assignedDepartment' in incomingData) || (incomingData.assignedDepartment in ['BBMP', 'BWSSB', 'BESCOM', 'Other']));
    }

    // -------------------------------------------------------------
    // Collections
    // -------------------------------------------------------------

    // 1. Users Collection
    match /users/{userId} {
      // Single profile get: Owner or Staff can inspect full profile
      allow get: if isOwner(userId) || isOfficial() || isAdmin();
      // Public list: Leaderboard display
      allow list: if true;

      allow create: if isOwner(userId) && isValidUserProfileCreate(incoming(), userId);
      allow update: if (isOwner(userId) && isValidUserProfileUpdate(existing(), incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Issues Collection
    match /issues/{issueId} {
      // Publicly readable civic issues
      allow get, list: if true;

      allow create: if isSignedIn() && isValidId(issueId) && isValidCivicIssueCreate(incoming(), issueId);

      allow update: if isSignedIn() && isValidId(issueId) && (
        isValidVerificationAction(existing(), incoming()) ||
        (isOfficial() && isValidOfficialStatusUpdate(existing(), incoming())) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 3. Daily Digests Collection
    match /digests/{digestId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // 4. Metadata Collection
    match /metadata/{metadataId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // 5. Admins Collection (Restricted strictly to Administrators)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
