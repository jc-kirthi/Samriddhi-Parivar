rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default-deny all unmatched paths)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Global Authentication & Role Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'its.me.jckirthi@gmail.com' ||
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Citizen') == 'Admin')
      );
    }

    function isOfficial() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Citizen') in ['Official', 'Admin'])
      );
    }

    // -------------------------------------------------------------
    // User Profile Validation Blueprints
    // -------------------------------------------------------------
    function isValidUserProfileCreate(data, userId) {
      return data.uid == userId &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.points is number && data.points == 0 &&
             data.badges is list && data.badges.size() <= 10 &&
             data.reportedCount is number && data.reportedCount == 0 &&
             data.verifiedCount is number && data.verifiedCount == 0 &&
             data.resolvedCount is number && data.resolvedCount == 0 &&
             (!('role' in data) || data.role == 'Citizen');
    }

    function isValidUserProfileUpdate(existingData, incomingData) {
      return incomingData.uid == existingData.uid &&
             incomingData.points == existingData.points &&
             incomingData.badges == existingData.badges &&
             incomingData.reportedCount == existingData.reportedCount &&
             incomingData.verifiedCount == existingData.verifiedCount &&
             incomingData.resolvedCount == existingData.resolvedCount &&
             incomingData.get('role', 'Citizen') == existingData.get('role', 'Citizen') &&
             incomingData.diff(existingData).affectedKeys().hasOnly(['displayName', 'photoURL', 'email']) &&
             incomingData.displayName is string && incomingData.displayName.size() <= 100;
    }

    // -------------------------------------------------------------
    // Civic Issue Validation Blueprints
    // -------------------------------------------------------------
    function isValidCivicIssueCreate(data, issueId) {
      return data.id == issueId &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.category in ['Pothole', 'Water Leak', 'Broken Streetlight', 'Trash & Dumping', 'Graffiti', 'Other'] &&
             data.urgency in ['Low', 'Medium', 'High', 'Critical'] &&
             data.locationName is string && data.locationName.size() <= 1000 &&
             data.latitude is number &&
             data.longitude is number &&
             data.status == 'Reported' &&
             data.reportedBy == request.auth.uid &&
             data.reportedByName is string && data.reportedByName.size() <= 100 &&
             data.reportedAt is number &&
             data.verificationsCount == 0 &&
             data.verifiedBy is list && data.verifiedBy.size() == 0 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
             (!('voiceUrl' in data) || (data.voiceUrl is string && data.voiceUrl.size() <= 2000000)) &&
             (!('officialResponse' in data)) &&
             (!('officialResponseAt' in data)) &&
             (!('assignedDepartment' in data));
    }

    function isValidVerificationAction(existingData, incomingData) {
      return incomingData.diff(existingData).affectedKeys().hasOnly(['verifiedBy', 'verificationsCount', 'status', 'timestamps', 'relatedIssues']) &&
             existingData.reportedBy != request.auth.uid &&
             !(request.auth.uid in existingData.verifiedBy) &&
             incomingData.verifiedBy.size() == existingData.verifiedBy.size() + 1 &&
             incomingData.verifiedBy[existingData.verifiedBy.size() - 1] == request.auth.uid &&
             incomingData.verificationsCount == existingData.verificationsCount + 1 &&
             incomingData.status == (incomingData.verificationsCount >= 3 && existingData.status == 'Reported' ? 'Verified' : existingData.status);
    }

    function isValidOfficialStatusUpdate(existingData, incomingData) {
      return incomingData.id == existingData.id &&
             incomingData.reportedBy == existingData.reportedBy &&
             incomingData.status in ['Reported', 'Verified', 'Assigned', 'In Progress', 'Repair Scheduled', 'Fix Completed', 'Resolved'] &&
             (!('officialResponse' in incomingData) || (incomingData.officialResponse is string && incomingData.officialResponse.size() <= 5000)) &&
             (!('assignedDepartment' in incomingData) || (incomingData.assignedDepartment in ['BBMP', 'BWSSB', 'BESCOM', 'Other']));
    }

    // -------------------------------------------------------------
    // Collections
    // -------------------------------------------------------------

    // 1. Users Collection
    match /users/{userId} {
      // Single profile get: Owner or Staff can inspect full profile
      allow get: if isOwner(userId) || isOfficial() || isAdmin();
      // Public list: Leaderboard display
      allow list: if true;

      allow create: if isOwner(userId) && isValidUserProfileCreate(incoming(), userId);
      allow update: if (isOwner(userId) && isValidUserProfileUpdate(existing(), incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Issues Collection
    match /issues/{issueId} {
      // Publicly readable civic issues
      allow get, list: if true;

      allow create: if isSignedIn() && isValidId(issueId) && isValidCivicIssueCreate(incoming(), issueId);

      allow update: if isSignedIn() && isValidId(issueId) && (
        isValidVerificationAction(existing(), incoming()) ||
        (isOfficial() && isValidOfficialStatusUpdate(existing(), incoming())) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 3. Daily Digests Collection
    match /digests/{digestId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Metadata Collection
    match /metadata/{metadataId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
